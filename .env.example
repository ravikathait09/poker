# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/ganga-poker

# JWT secret (use a long random string in production)
JWT_SECRET=change-me-in-production-min-32-chars-long!!

# Realtime server port (must match below on the client when using LAN IP)
REALTIME_PORT=4001

# Port baked into the browser when deriving ws://<your-ip>:PORT (defaults to 4001)
NEXT_PUBLIC_REALTIME_PORT=4001

# Optional explicit WS URL (production / reverse proxy). Leave as localhost for dev —
# when you open the site via http://192.168.x.x, the app uses that host for WS automatically.
NEXT_PUBLIC_WS_URL=ws://127.0.0.1:4001

# Bootstrap first admin (optional) — comma-separated usernames that get role admin on first seed
ADMIN_USERNAMES=admin

# Local E2E: host can add CPU players (check/call). Set on realtime + rebuild Next for public flag.
GANGA_DEV_BOTS=1
NEXT_PUBLIC_GANGA_DEV_BOTS=1
